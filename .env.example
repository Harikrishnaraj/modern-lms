# Copy to .env.local and fill in. Never commit .env.local.
# Only NEXT_PUBLIC_* values are sent to the browser.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Phase 1)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never import in client code.
SUPABASE_SERVICE_ROLE_KEY=

# Email — Resend (T-141): announcements/delivery log. RESEND_FROM_EMAIL must be a domain verified
# in the Resend dashboard to send to arbitrary recipients; the sandbox sender (onboarding@resend.dev)
# only delivers to the account owner's own verified email.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Payments (later)
PAYMENT_PROVIDER_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

# AI (later)
AI_PROVIDER_API_KEY=

# Scheduled reports (T-140): shared secret checked by /api/cron/scheduled-reports.
# Point an external scheduler (e.g. a Vercel Cron entry in vercel.json, or any host's cron) at
# that route with an "Authorization: Bearer <value>" header set to this secret, on whatever cadence
# you want scheduled exports checked (e.g. hourly).
CRON_SECRET=

# SCORM content origin: a different host than the app that serves the same deployment (e.g. https://scorm.example.com).
# Lets multi-frame packages (Storyline, Rise) run while staying isolated from the app. Local dev: http://127.0.0.1:3000
# Unset = strict single-origin-per-frame sandbox (simple single-page packages only).
NEXT_PUBLIC_SCORM_CONTENT_ORIGIN=
